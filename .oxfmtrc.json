{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "printWidth": 120,
  "trailingComma": "all",
  "jsxSingleQuote": false,
  "sortTailwindcss": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".output/",
    ".wxt/",
    ".traces/",
    ".codegraph/",
    ".prettierrc",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "vitest.config.mts",
    "web-ext.config.ts",
    "wxt.config.ts",
    "design-demos/",
    "plans/",
    ".impeccable/",
    "PRODUCT.md",
    "noon-endpoints-extended.md",
    "noon-listing-flow.md",
    ".DS_Store",
    ".git/"
  ]
}
